# Fine-grained PAT: Followers permission = Read and write
# Classic PAT alternative: user:follow
GITHUB_REFOLLOW_TOKEN=github_pat_replace_me

# Random secret used by the dashboard's Run now endpoint.
GITHUB_REFOLLOW_API_KEY=replace-with-a-long-random-secret

# Keep true until you have verified the detected following list.
GITHUB_REFOLLOW_DRY_RUN=true
GITHUB_REFOLLOW_DELAY_SECONDS=2
TZ=Asia/Ho_Chi_Minh
